{
  "schemaVersion": 1,
  "id": "simon.workspaces-per-monitor",
  "name": "Workspaces (per monitor + icons)",
  "version": "1.0.1",
  "author": "Simon",
  "description": "Show only the workspaces belonging to each monitor, with per-app icons for open windows",
  "license": "MIT",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Workspaces.qml"
  },
  "barWidget": {
    "displayName": "Workspaces (per monitor + icons)",
    "description": "Per-monitor workspace indicators with per-app icons for open windows",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "maxWorkspaceId": 10,
      "showNumberAlways": true,
      "deduplicateIcons": false,
      "iconSpacing": 4,
      "maxIconsPerWorkspace": 0,
      "pillMarginY": 6
    },
    "schema": [
      {
        "key": "maxWorkspaceId",
        "type": "integer",
        "label": "Highest workspace ID to show",
        "min": 1,
        "max": 20,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "showNumberAlways",
        "type": "boolean",
        "label": "Always show workspace number (even when focused)",
        "defaultValue": true
      },
      {
        "key": "deduplicateIcons",
        "type": "boolean",
        "label": "Deduplicate identical app icons per workspace",
        "defaultValue": false
      },
      {
        "key": "iconSpacing",
        "type": "integer",
        "label": "Icon spacing (px)",
        "min": 1,
        "max": 16,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "maxIconsPerWorkspace",
        "type": "integer",
        "label": "Maximum icons per workspace (0 = unlimited)",
        "min": 0,
        "max": 10,
        "step": 1,
        "defaultValue": 0
      },
      {
        "key": "pillMarginY",
        "type": "integer",
        "label": "Vertical space above and below the pill (px)",
        "min": 0,
        "max": 14,
        "step": 1,
        "defaultValue": 6
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.workspaces"
  }
}
